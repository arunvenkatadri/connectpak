{
  "name": "connectpak-pinecone",
  "version": "0.1.0",
  "description": "Read-only Pinecone access for AI agents over MCP: list schemas, describe tables, sample rows, and run guarded queries.",
  "author": {
    "name": "connectpak contributors",
    "url": "https://github.com/arunvenkatadri/connectpak"
  },
  "homepage": "https://github.com/arunvenkatadri/connectpak",
  "repository": "https://github.com/arunvenkatadri/connectpak",
  "license": "MIT",
  "keywords": [
    "mcp",
    "database",
    "read-only",
    "vector",
    "pinecone"
  ],
  "userConfig": {
    "connection": {
      "type": "string",
      "title": "Pinecone API key",
      "description": "Passed to the server as $CONNECTPAK_PINECONE_API_KEY. Example: pcsk_xxxxx. Use read-only credentials.",
      "sensitive": true,
      "required": true
    }
  },
  "mcpServers": {
    "pinecone": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/arunvenkatadri/connectpak#subdirectory=packages/vector-pinecone",
        "connectpak-vector-pinecone"
      ],
      "env": {
        "CONNECTPAK_PINECONE_API_KEY": "${user_config.connection}"
      }
    }
  }
}
