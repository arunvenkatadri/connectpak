{
  "name": "connectpak-clickhouse",
  "version": "0.1.0",
  "description": "Read-only ClickHouse access for AI agents over MCP: list schemas, describe tables, sample rows, and run guarded queries.",
  "author": {
    "name": "connectpak contributors",
    "url": "https://github.com/arunvenkatadri/connectpak"
  },
  "homepage": "https://github.com/arunvenkatadri/connectpak",
  "repository": "https://github.com/arunvenkatadri/connectpak",
  "license": "MIT",
  "keywords": [
    "mcp",
    "database",
    "read-only",
    "sql",
    "clickhouse"
  ],
  "userConfig": {
    "connection": {
      "type": "string",
      "title": "ClickHouse DSN",
      "description": "Passed to the server as $CONNECTPAK_CLICKHOUSE_DSN. Example: clickhouse://reader:pw@localhost:8123/default. Use read-only credentials.",
      "sensitive": true,
      "required": true
    }
  },
  "mcpServers": {
    "clickhouse": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/arunvenkatadri/connectpak#subdirectory=packages/sql-clickhouse",
        "connectpak-sql-clickhouse"
      ],
      "env": {
        "CONNECTPAK_CLICKHOUSE_DSN": "${user_config.connection}"
      }
    }
  }
}
