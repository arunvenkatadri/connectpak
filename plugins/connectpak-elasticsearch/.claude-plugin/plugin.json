{
  "name": "connectpak-elasticsearch",
  "version": "0.1.0",
  "description": "Read-only Elasticsearch access for AI agents over MCP: list schemas, describe tables, sample rows, and run guarded queries.",
  "author": {
    "name": "connectpak contributors",
    "url": "https://github.com/arunvenkatadri/connectpak"
  },
  "homepage": "https://github.com/arunvenkatadri/connectpak",
  "repository": "https://github.com/arunvenkatadri/connectpak",
  "license": "MIT",
  "keywords": [
    "mcp",
    "database",
    "read-only",
    "nosql",
    "elasticsearch",
    "search"
  ],
  "userConfig": {
    "connection": {
      "type": "string",
      "title": "Elasticsearch URL",
      "description": "Passed to the server as $CONNECTPAK_ELASTICSEARCH_URL. Example: http://elastic:pw@localhost:9200. Use read-only credentials.",
      "sensitive": true,
      "required": true
    }
  },
  "mcpServers": {
    "elasticsearch": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/arunvenkatadri/connectpak#subdirectory=packages/nosql-elasticsearch",
        "connectpak-nosql-elasticsearch"
      ],
      "env": {
        "CONNECTPAK_ELASTICSEARCH_URL": "${user_config.connection}"
      }
    }
  }
}
