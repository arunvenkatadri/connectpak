{
  "name": "connectpak-chroma",
  "version": "0.1.0",
  "description": "Read-only Chroma access for AI agents over MCP: list schemas, describe tables, sample rows, and run guarded queries.",
  "author": {
    "name": "connectpak contributors",
    "url": "https://github.com/arunvenkatadri/connectpak"
  },
  "homepage": "https://github.com/arunvenkatadri/connectpak",
  "repository": "https://github.com/arunvenkatadri/connectpak",
  "license": "MIT",
  "keywords": [
    "mcp",
    "database",
    "read-only",
    "vector",
    "chroma"
  ],
  "userConfig": {
    "connection": {
      "type": "string",
      "title": "Chroma server URL",
      "description": "Passed to the server as $CONNECTPAK_CHROMA_URL. Example: http://localhost:8000. Use read-only credentials.",
      "sensitive": true,
      "required": true
    }
  },
  "mcpServers": {
    "chroma": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/arunvenkatadri/connectpak#subdirectory=packages/vector-chroma",
        "connectpak-vector-chroma"
      ],
      "env": {
        "CONNECTPAK_CHROMA_URL": "${user_config.connection}"
      }
    }
  }
}
