{
  "name": "connectpak-arangodb",
  "version": "0.1.0",
  "description": "Read-only ArangoDB access for AI agents over MCP: list schemas, describe tables, sample rows, and run guarded queries.",
  "author": {
    "name": "connectpak contributors",
    "url": "https://github.com/arunvenkatadri/connectpak"
  },
  "homepage": "https://github.com/arunvenkatadri/connectpak",
  "repository": "https://github.com/arunvenkatadri/connectpak",
  "license": "MIT",
  "keywords": [
    "mcp",
    "database",
    "read-only",
    "graph",
    "arangodb",
    "aql"
  ],
  "userConfig": {
    "connection": {
      "type": "string",
      "title": "ArangoDB URL",
      "description": "Passed to the server as $CONNECTPAK_ARANGODB_URL. Example: http://root:pw@localhost:8529/_system. Use read-only credentials.",
      "sensitive": true,
      "required": true
    }
  },
  "mcpServers": {
    "arangodb": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/arunvenkatadri/connectpak#subdirectory=packages/graph-arangodb",
        "connectpak-graph-arangodb"
      ],
      "env": {
        "CONNECTPAK_ARANGODB_URL": "${user_config.connection}"
      }
    }
  }
}
