{
  "name": "connectpak-mysql",
  "version": "0.1.0",
  "description": "Read-only MySQL access for AI agents over MCP: list schemas, describe tables, sample rows, and run guarded queries.",
  "author": {
    "name": "connectpak contributors",
    "url": "https://github.com/arunvenkatadri/connectpak"
  },
  "homepage": "https://github.com/arunvenkatadri/connectpak",
  "repository": "https://github.com/arunvenkatadri/connectpak",
  "license": "MIT",
  "keywords": [
    "mcp",
    "database",
    "read-only",
    "sql",
    "mysql"
  ],
  "userConfig": {
    "connection": {
      "type": "string",
      "title": "MySQL DSN",
      "description": "Passed to the server as $CONNECTPAK_MYSQL_DSN. Example: mysql://reader:pw@db.example.com:3306/app. Use read-only credentials.",
      "sensitive": true,
      "required": true
    }
  },
  "mcpServers": {
    "mysql": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/arunvenkatadri/connectpak#subdirectory=packages/sql-mysql",
        "connectpak-sql-mysql"
      ],
      "env": {
        "CONNECTPAK_MYSQL_DSN": "${user_config.connection}"
      }
    }
  }
}
