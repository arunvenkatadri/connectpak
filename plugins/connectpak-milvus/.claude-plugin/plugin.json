{
  "name": "connectpak-milvus",
  "version": "0.1.0",
  "description": "Read-only Milvus access for AI agents over MCP: list schemas, describe tables, sample rows, and run guarded queries.",
  "author": {
    "name": "connectpak contributors",
    "url": "https://github.com/arunvenkatadri/connectpak"
  },
  "homepage": "https://github.com/arunvenkatadri/connectpak",
  "repository": "https://github.com/arunvenkatadri/connectpak",
  "license": "MIT",
  "keywords": [
    "mcp",
    "database",
    "read-only",
    "vector",
    "milvus"
  ],
  "userConfig": {
    "connection": {
      "type": "string",
      "title": "Milvus URI",
      "description": "Passed to the server as $CONNECTPAK_MILVUS_URI. Example: http://localhost:19530. Use read-only credentials.",
      "sensitive": true,
      "required": true
    }
  },
  "mcpServers": {
    "milvus": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/arunvenkatadri/connectpak#subdirectory=packages/vector-milvus",
        "connectpak-vector-milvus"
      ],
      "env": {
        "CONNECTPAK_MILVUS_URI": "${user_config.connection}"
      }
    }
  }
}
