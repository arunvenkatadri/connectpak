{
  "name": "connectpak-redshift",
  "version": "0.1.0",
  "description": "Read-only Redshift access for AI agents over MCP: list schemas, describe tables, sample rows, and run guarded queries.",
  "author": {
    "name": "connectpak contributors",
    "url": "https://github.com/arunvenkatadri/connectpak"
  },
  "homepage": "https://github.com/arunvenkatadri/connectpak",
  "repository": "https://github.com/arunvenkatadri/connectpak",
  "license": "MIT",
  "keywords": [
    "mcp",
    "database",
    "read-only",
    "sql",
    "redshift",
    "aws"
  ],
  "userConfig": {
    "connection": {
      "type": "string",
      "title": "Redshift DSN",
      "description": "Passed to the server as $CONNECTPAK_REDSHIFT_DSN. Example: redshift://user:pw@host:5439/db. Use read-only credentials.",
      "sensitive": true,
      "required": true
    }
  },
  "mcpServers": {
    "redshift": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/arunvenkatadri/connectpak#subdirectory=packages/sql-redshift",
        "connectpak-sql-redshift"
      ],
      "env": {
        "CONNECTPAK_REDSHIFT_DSN": "${user_config.connection}"
      }
    }
  }
}
