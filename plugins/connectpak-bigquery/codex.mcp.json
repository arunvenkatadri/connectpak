{
  "mcpServers": {
    "bigquery": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/arunvenkatadri/connectpak#subdirectory=packages/sql-bigquery",
        "connectpak-sql-bigquery"
      ],
      "env_vars": [
        "CONNECTPAK_BIGQUERY_PROJECT",
        "GOOGLE_APPLICATION_CREDENTIALS",
        "GOOGLE_CLOUD_PROJECT",
        "CLOUDSDK_CONFIG"
      ]
    }
  }
}
