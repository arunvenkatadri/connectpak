{
  "name": "connectpak-mongodb",
  "version": "0.1.0",
  "description": "Read-only MongoDB access for AI agents over MCP: list schemas, describe tables, sample rows, and run guarded queries.",
  "author": {
    "name": "connectpak contributors",
    "url": "https://github.com/arunvenkatadri/connectpak"
  },
  "homepage": "https://github.com/arunvenkatadri/connectpak",
  "repository": "https://github.com/arunvenkatadri/connectpak",
  "license": "MIT",
  "keywords": [
    "mcp",
    "database",
    "read-only",
    "nosql",
    "mongodb"
  ],
  "userConfig": {
    "connection": {
      "type": "string",
      "title": "MongoDB URI",
      "description": "Passed to the server as $CONNECTPAK_MONGODB_URI. Example: mongodb://user:pw@host:27017/dbname. Use read-only credentials.",
      "sensitive": true,
      "required": true
    }
  },
  "mcpServers": {
    "mongodb": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/arunvenkatadri/connectpak#subdirectory=packages/nosql-mongodb",
        "connectpak-nosql-mongodb"
      ],
      "env": {
        "CONNECTPAK_MONGODB_URI": "${user_config.connection}"
      }
    }
  }
}
