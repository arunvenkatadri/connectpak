{
  "name": "connectpak-cassandra",
  "version": "0.1.0",
  "description": "Read-only Cassandra access for AI agents over MCP: list schemas, describe tables, sample rows, and run guarded queries.",
  "author": {
    "name": "connectpak contributors",
    "url": "https://github.com/arunvenkatadri/connectpak"
  },
  "homepage": "https://github.com/arunvenkatadri/connectpak",
  "repository": "https://github.com/arunvenkatadri/connectpak",
  "license": "MIT",
  "keywords": [
    "mcp",
    "database",
    "read-only",
    "nosql",
    "cassandra",
    "cql"
  ],
  "userConfig": {
    "connection": {
      "type": "string",
      "title": "Cassandra contact points",
      "description": "Passed to the server as $CONNECTPAK_CASSANDRA_HOSTS. Example: user:pw@127.0.0.1:9042. Use read-only credentials.",
      "sensitive": true,
      "required": true
    }
  },
  "mcpServers": {
    "cassandra": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/arunvenkatadri/connectpak#subdirectory=packages/nosql-cassandra",
        "connectpak-nosql-cassandra"
      ],
      "env": {
        "CONNECTPAK_CASSANDRA_HOSTS": "${user_config.connection}"
      }
    }
  }
}
