{
  "name": "connectpak-dynamodb",
  "version": "0.1.0",
  "description": "Read-only DynamoDB access for AI agents over MCP: list schemas, describe tables, sample rows, and run guarded queries.",
  "author": {
    "name": "connectpak contributors",
    "url": "https://github.com/arunvenkatadri/connectpak"
  },
  "homepage": "https://github.com/arunvenkatadri/connectpak",
  "repository": "https://github.com/arunvenkatadri/connectpak",
  "license": "MIT",
  "keywords": [
    "mcp",
    "database",
    "read-only",
    "nosql",
    "dynamodb",
    "aws"
  ],
  "userConfig": {
    "connection": {
      "type": "string",
      "title": "AWS region",
      "description": "Passed to the server as $CONNECTPAK_DYNAMODB_REGION. Example: us-east-1. Use read-only credentials.",
      "sensitive": false,
      "required": true
    }
  },
  "mcpServers": {
    "dynamodb": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/arunvenkatadri/connectpak#subdirectory=packages/nosql-dynamodb",
        "connectpak-nosql-dynamodb"
      ],
      "env": {
        "CONNECTPAK_DYNAMODB_REGION": "${user_config.connection}"
      }
    }
  }
}
