{
  "name": "connectpak-memgraph",
  "version": "0.1.0",
  "description": "Read-only Memgraph access for AI agents over MCP: list schemas, describe tables, sample rows, and run guarded queries.",
  "author": {
    "name": "connectpak contributors",
    "url": "https://github.com/arunvenkatadri/connectpak"
  },
  "homepage": "https://github.com/arunvenkatadri/connectpak",
  "repository": "https://github.com/arunvenkatadri/connectpak",
  "license": "MIT",
  "keywords": [
    "mcp",
    "database",
    "read-only",
    "graph",
    "memgraph",
    "cypher"
  ],
  "userConfig": {
    "connection": {
      "type": "string",
      "title": "Memgraph Bolt URI",
      "description": "Passed to the server as $CONNECTPAK_MEMGRAPH_URI. Example: bolt://user:pw@localhost:7687. Use read-only credentials.",
      "sensitive": true,
      "required": true
    }
  },
  "mcpServers": {
    "memgraph": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/arunvenkatadri/connectpak#subdirectory=packages/graph-memgraph",
        "connectpak-graph-memgraph"
      ],
      "env": {
        "CONNECTPAK_MEMGRAPH_URI": "${user_config.connection}"
      }
    }
  }
}
