{
  "name": "connectpak-weaviate",
  "version": "0.1.0",
  "description": "Read-only Weaviate access for AI agents over MCP: list schemas, describe tables, sample rows, and run guarded queries.",
  "author": {
    "name": "connectpak contributors",
    "url": "https://github.com/arunvenkatadri/connectpak"
  },
  "homepage": "https://github.com/arunvenkatadri/connectpak",
  "repository": "https://github.com/arunvenkatadri/connectpak",
  "license": "MIT",
  "keywords": [
    "mcp",
    "database",
    "read-only",
    "vector",
    "weaviate"
  ],
  "userConfig": {
    "connection": {
      "type": "string",
      "title": "Weaviate URL",
      "description": "Passed to the server as $CONNECTPAK_WEAVIATE_URL. Example: https://my-cluster.weaviate.network. Use read-only credentials.",
      "sensitive": true,
      "required": true
    }
  },
  "mcpServers": {
    "weaviate": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/arunvenkatadri/connectpak#subdirectory=packages/vector-weaviate",
        "connectpak-vector-weaviate"
      ],
      "env": {
        "CONNECTPAK_WEAVIATE_URL": "${user_config.connection}"
      }
    }
  }
}
